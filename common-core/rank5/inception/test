ts/nginx/certs:/etc/nginx/certs ports: - "443:443" restart: unless-stopped depends_on: - wordpress networks: webnet: driver: bridge ===== ./srcs/.env ===== # Database MYSQL_DATABASE=wordpress MYSQL_USER=db_user MYSQL_PASSWORD=norban MYSQL_ROOT_PASSWORD=a_norban # WordPress WORDPRESS_DB_HOST=mariadb:3306 WORDPRESS_DB_USER=wp_user WORDPRESS_DB_PASSWORD=norban WORDPRESS_DB_NAME=wordpress # Domain DOMAIN_NAME=norban.42.fr ===== ./Makefile ===== # Makefile for inception project NAME = inception COMPOSE_FILE = srcs/docker-compose.yml up: docker compose -f $(COMPOSE_FILE) up -d --build down: docker compose -f $(COMPOSE_FILE) down clean: docker compose -f $(COMPOSE_FILE) down -v docker system prune -af docker network prune -f network-fix: docker network connect srcs_webnet wordpress || true docker network connect srcs_webnet mariadb || true all: up re: clean up .PHONY: up down clean network-fix all re

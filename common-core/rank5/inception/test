IDENTIFIED BY '${MYSQL_PASSWORD}'; GRANT ALL PRIVILEGES ON \${MYSQL_DATABASE}\.* TO '${MYSQL_USER}'@'%'; -- create wordpress user optionally (WORDPRESS_DB_USER) CREATE USER IF NOT EXISTS '${WORDPRESS_DB_USER}'@'%' IDENTIFIED BY '${WORDPRESS_DB_PASSWORD}'; GRANT ALL PRIVILEGES ON \${WORDPRESS_DB_NAME}\.* TO '${WORDPRESS_DB_USER}'@'%'; FLUSH PRIVILEGES; EOSQL # stop temporary mysqld echo "[mariadb-entrypoint] shutting down temporary mysqld" mysqladmin -uroot -p"${MYSQL_ROOT_PASSWORD}" shutdown || kill "$pid" || true fi # exec the normal server (trusting CMD or use mysqld_safe) exec "$@" ===== ./srcs/requirements/nginx/nginx.conf ===== events {} http { server { listen 443 ssl; server_name norban.42.fr; ssl_certificate /etc/nginx/certs/selfsigned.crt; ssl_certificate_key /etc/nginx/certs/selfsigned.key; ssl_protocols TLSv1.2 TLSv1.3; root /usr/share/nginx/html; index index.php index.html; location / { try_files $uri $uri/ /index.php?$args; } location ~ \.php$ { fastcgi_pass wordpress:9000; fastcgi_read_timeout 60s; fastcgi_index index.php; include fastcgi_params; fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name; } } } ===== ./srcs/requirements/nginx/Dockerfile ===== FROM alpine:3.21 RUN apk add --no-cache nginx openssl RUN mkdir -p /etc/nginx/certs /var/www/html /run/nginx # Generate self-signed cert for TLSv1.2+ RUN openssl req -x509 -newkey rsa:2048 -days 365 -nodes \ -keyout /etc/nginx/certs/selfsigned.key \ -out /etc/nginx/certs/selfsigned.crt \ -subj "/CN=norban.42.fr" COPY ./conf/nginx.conf /etc/nginx/nginx.conf EXPOSE 443 CMD ["nginx", "-g", "daemon off;"] ===== ./srcs/requirements/nginx/conf/nginx.conf ===== server { listen 443 ssl; server_name localhost; ssl_certificate /etc/nginx/certs/selfsigned.crt; ssl_certificate_key /etc/nginx/certs/selfsigned.key; root /usr/share/nginx/html; index index.php index.html index.htm; location / { try_files $uri $uri/ /index.php?$args; } location ~ \.php$ { include fastcgi_params; fastcgi_pass wordpress:9000; fastcgi_index index.php; fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name; } } ===== ./srcs/requirements/wordpress/entrypoint.sh ===== #!/bin/sh set -e # Print a header echo "[wp-entrypoint] Starting initialization" WP_DIR="/var/www/html" DEFAULT_DIR="/var/www/html-default" OWNER="www-data:www-data" # If mounted WP_DIR is empty (first run), copy default WP files if [ ! "$(ls -A "$WP_DIR" 2>/dev/null)" ]; then echo "[wp-entrypoint] $WP_DIR is empty — copying default WordPress files" cp -a "$DEFAULT_DIR/." "$WP_DIR/" chown -R $OWNER "$WP_DIR" fi # If wp-config.php missing but env vars provided, generate minimal config if [ ! -f "$WP_DIR/wp-config.php" ] && [ -n "${WORDPRESS_DB_HOST}" ] && [ -n "${WORDPRESS_DB_USER}" ]; then echo "[wp-entrypoint] Generating wp-config.php from environment" cat > "$WP_DIR/wp-config.php" <<EOF <?php define('DB_NAME', '${WORDPRESS_DB_NAME}'); define('DB_USER', '${WORDPRESS_DB_USER}'); define('DB_PASSWORD', '${WORDPRESS_DB_PASSWORD}'); define('DB_HOST', '${WORDPRESS_DB_HOST}'); define('DB_CHARSET', 'utf8mb4'); define('DB_COLLATE', ''); \$table_prefix = 'wp_'; define('WP_DEBUG', false); /* That's all, stop editing! */ if ( ! defined('ABSPATH') ) { define('ABSPATH', dirname(__FILE__) . '/'); } require_once(ABSPATH . 'wp-settings.php'); EOF chown $OWNER "$WP_DIR/wp-config.php" fi # (Optional) Wait for database to be ready if [ -n "${WORDPRESS_DB_HOST}" ]; then IFS=':' read -r DB_HOST DB_PORT <<< "${WORDPRESS_DB_HOST}" DB_PORT=${DB_PORT:-3306} echo "[wp-entrypoint] Waiting for database at ${DB_HOST}:${DB_PORT}..." while ! mysqladmin ping -h "${DB_HOST}" -P "${DB_PORT}" --silent; do printf '.' sleep 1 done echo echo "[wp-entrypoint] Database is reachable" fi echo "[wp-entrypoint] Executing command: $*" exec "$@" ===== ./srcs/requirements/wordpress/Dockerfile ===== # srcs/requirements/wordpress/Dockerfile FROM debian:bookworm # Install PHP-FPM + extensions + tools RUN apt-get update && apt-get install -y \ php8.2-fpm php8.2-mysql p